#!/bin/sh
# The owner's rule (2026-11-14): no commit names the machine a run used. Enabled per clone with
#   git config core.hooksPath .githooks
# and run by the gate as `node tools/no-machine-details.mjs --all`.
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node isn't on PATH, so the machine-details check can't run (tools/no-machine-details.mjs)." >&2
  exit 1
fi
exec node "$(git rev-parse --show-toplevel)/tools/no-machine-details.mjs"
